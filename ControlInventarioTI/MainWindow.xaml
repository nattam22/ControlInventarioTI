<Window x:Class="ControlInventarioTI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControlInventarioTI"
        mc:Ignorable="d"
        Title="Inventario" Height="450" Width="800">
    <Grid>
        <DockPanel LastChildFill="False">
            <Menu DockPanel.Dock="Top" Background="#FFE2EDD7" Height="20">
                <MenuItem Header="Operaciones">
                    <MenuItem Header="Insertar"
                      x:Name="mnInsertar"
                      Click="Insertar_Click"/>
                    <MenuItem Header="Eliminar"
                              x:Name="mnEliminar"
                              Click="Eliminar_Click"/>
                </MenuItem>
                <MenuItem Header="_Reportes">
                    <MenuItem Header="Reporte RDLC General"
               x:Name="mnReporte"
               Click="Reporte_Click"/>
                </MenuItem>
            </Menu>
        </DockPanel>
    </Grid>
</Window>
