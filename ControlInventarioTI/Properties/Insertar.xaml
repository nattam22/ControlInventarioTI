<Window x:Class="ControlInventarioTI.Properties.Insertar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControlInventarioTI.Properties"
        mc:Ignorable="d"
        Title="Insertar Registro" Height="450" Width="800">
    <Grid>

        <Grid Margin="61,26,54,0" Background="#FFCCC2D7" VerticalAlignment="Top" Height="46">
            <Label Content="Insertar" Height="46" Width="84" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="20"/>
        </Grid>

        <Grid x:Name="Panel" Background="#FFE3E1D5" Margin="61,86,54,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="344"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            
            <Label Content="Id" Grid.Row="0" Grid.Column="0" Width="150" HorizontalAlignment="Right" Margin="0,0,25,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" HorizontalContentAlignment="Center" Background="#FFD6D2E5" BorderBrush="Black"/>
            <Label Content="Marca" Grid.Row="1" Grid.Column="0" Width="150" HorizontalAlignment="Right" Margin="0,0,25,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" HorizontalContentAlignment="Center" Background="#FFD6D2E5" BorderBrush="Black"/>
            <Label Content="Modelo" Grid.Row="2" Grid.Column="0" Width="150" HorizontalAlignment="Right" Margin="0,0,25,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" HorizontalContentAlignment="Center" Background="#FFD6D2E5" BorderBrush="Black"/>
            <Label Content="Tipo de Equipo" Grid.Row="3" Grid.Column="0" Width="150" HorizontalAlignment="Right" Margin="0,0,25,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" HorizontalContentAlignment="Center" Background="#FFD6D2E5" BorderBrush="Black"/>
            <Label Content="Fecha de compra" Grid.Row="4" Grid.Column="0" Width="150" HorizontalAlignment="Right" Margin="0,0,25,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" HorizontalContentAlignment="Center" Background="#FFD6D2E5" BorderBrush="Black"/>
            <Label Content="Precio" Grid.Row="5" Grid.Column="0" Width="150" HorizontalAlignment="Right" Margin="0,0,25,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" HorizontalContentAlignment="Center" Background="#FFD6D2E5" BorderBrush="Black"/>

           
            <TextBox x:Name="txtId" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="18,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="179" Height="25"/>
            <TextBox x:Name="txtMarca" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="18,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="179" Height="25"/>
            <TextBox x:Name="txtModelo" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="18,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="179" Height="25"/>
            <TextBox x:Name="txtTipoEquipo" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="18,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="179" Height="25"/>
            <TextBox x:Name="txtFechaCompra" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Margin="18,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="179" Height="25"/>
            <TextBox x:Name="txtPrecio" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Margin="18,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="179" Height="25"/>

            
            <Button x:Name="btnGuardar" Content="Guardar" HorizontalAlignment="Left" Margin="226,0,0,0" Grid.Row="6" VerticalAlignment="Center" Background="#FFD8B7ED" Width="73" FontSize="16" FontWeight="Bold" Click="btn_Guardar"/>
            <Button x:Name="btnCancelar" Content="Cancelar" HorizontalAlignment="Left" Margin="342,0,0,0" Grid.Row="6" VerticalAlignment="Center" Background="#FFD8B7ED" Width="74" FontSize="16" FontWeight="Bold" Grid.ColumnSpan="2" Click="btn_Cancelar"/>

        </Grid>
    </Grid>
</Window>