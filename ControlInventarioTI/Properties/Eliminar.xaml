<Window x:Class="ControlInventarioTI.Properties.Eliminar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControlInventarioTI.Properties"
        mc:Ignorable="d"
        Title="Eliminar Registro" Height="450" Width="800">
    <Grid>

        <Grid Margin="61,26,54,0" Background="#FFC2D7CF" VerticalAlignment="Top" Height="46">
            <Label Content="ID:" Height="32" Margin="68,0,411,0" FontSize="16" VerticalAlignment="Center" Foreground="Black" FontWeight="Bold" Background="Transparent"/>
            <TextBox x:Name="txtId" Text="" FontSize="16" Width="120" Height="28" VerticalContentAlignment="Center" Margin="122,10,443,8"/>
            <Button x:Name="btnBuscar" Content="Buscar" FontSize="16" FontWeight="Bold" Height="28" Margin="279,10,299,8" Cursor="Hand" Click="btnBuscar_Click"/>

            <Label Content="Eliminar" Height="46" Width="97" VerticalAlignment="Top" HorizontalAlignment="Left" FontWeight="Bold" FontSize="20" Margin="477,3,0,0"/>
        </Grid>

        <Grid x:Name="Panel" Background="#FFE8F3F6" Margin="61,86,54,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="344"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>



            <Label Content="Marca" Grid.Column="0" Width="150" HorizontalAlignment="Right" Margin="0,24,24,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16" HorizontalContentAlignment="Center" Background="#FFD2DEE5" BorderBrush="Black" Grid.RowSpan="2"/>
            <Label Content="Modelo" Grid.Row="1" Grid.Column="0" Width="150" HorizontalAlignment="Right" Margin="0,24,24,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16" HorizontalContentAlignment="Center" Background="#FFD2DEE5" BorderBrush="Black" Grid.RowSpan="2"/>
            <Label Content="Tipo de Equipo" Grid.Row="2" Grid.Column="0" Width="150" HorizontalAlignment="Right" Margin="0,24,24,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16" HorizontalContentAlignment="Center" Background="#FFD2DEE5" BorderBrush="Black" Grid.RowSpan="2"/>
            <Label Content="Fecha de compra" Grid.Row="3" Grid.Column="0" Width="150" HorizontalAlignment="Right" Margin="0,24,24,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16" HorizontalContentAlignment="Center" Background="#FFD2DEE5" BorderBrush="Black" Grid.RowSpan="2"/>
            <Label Content="Precio" Grid.Row="4" Grid.Column="0" Width="150" HorizontalAlignment="Right" Margin="0,21,24,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16" HorizontalContentAlignment="Center" Background="#FFD2DEE5" BorderBrush="Black" Grid.RowSpan="2"/>



            <TextBox x:Name="txtMarca" Grid.Column="1" HorizontalAlignment="Left" Margin="18,27,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Height="25" Grid.RowSpan="2"/>
            <TextBox x:Name="txtModelo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="18,27,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Height="25" Grid.RowSpan="2"/>
            <TextBox x:Name="txtTipoEquipo" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="18,27,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Height="25" Grid.RowSpan="2"/>
            <TextBox x:Name="txtFechaCompra" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="18,27,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Height="25" Grid.RowSpan="2"/>
            <TextBox x:Name="txtPrecio" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Margin="18,25,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="180" Height="25" Grid.RowSpan="2"/>


            <Button x:Name="btnEliminar" Content="Eliminar" HorizontalAlignment="Left" Margin="226,27,0,0" Grid.Row="5" VerticalAlignment="Top" Background="#FFB7EDED" Width="74" FontSize="16" FontWeight="Bold" Click="btn_Eliminar" Grid.RowSpan="2"/>
            <Button x:Name="btnCancelar" Content="Cancelar" HorizontalAlignment="Left" Margin="342,27,0,0" Grid.Row="5" VerticalAlignment="Top" Background="#FFB7EDED" Width="74" FontSize="16" FontWeight="Bold" Grid.ColumnSpan="2" Click="btn_Cancelar" Grid.RowSpan="2"/>

        </Grid>
    </Grid>
</Window>